---
import type { GetStaticPaths } from 'astro';
import ArticleListCard from '../components/ArticleListCard.astro';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { getCollection } from 'astro:content';

export const getStaticPaths = (async ({ paginate }) => {
	const posts = (
		await getCollection('article', ({ data }) => import.meta.env.DEV || !data.draft)
	).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

	return paginate(posts, { pageSize: 6 });
}) satisfies GetStaticPaths;

const { page } = Astro.props;

const categories = ['All', 'Tech', 'Project'];
const pageNumbers = Array.from({ length: page.lastPage }, (_, i) => i + 1);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			.banner {
				width: 100%;
				height: 280px;
				object-fit: cover;
				display: block;
			}
			main {
				width: 960px;
				padding-top: 2.5em;
			}
			.tabs {
				position: relative;
				display: flex;
				gap: 0.75rem;
				margin-bottom: 2rem;
				padding-bottom: 1.5rem;
				border-bottom: 1px solid rgb(var(--gray-light));
			}
			.tab-indicator {
				position: absolute;
				top: 0;
				left: 0;
				height: 2.25em;
				border-radius: 100px;
				background: var(--accent);
				transition:
					left 0.3s ease,
					width 0.3s ease;
			}
			.tab {
				position: relative;
				z-index: 1;
				padding: 0.5em 1.25em;
				border: 1px solid rgb(var(--gray-light));
				border-radius: 100px;
				background: white;
				color: rgb(var(--gray-dark));
				font-size: 15px;
				font-weight: 600;
				cursor: pointer;
				transition: color 0.2s ease;
			}
			.tab.active {
				background: transparent;
				border-color: transparent;
				color: white;
			}
			.list-wrapper {
				min-height: 28rem;
			}
			ul {
				display: flex;
				flex-direction: column;
				gap: 1.5rem;
				list-style-type: none;
				margin: 0;
				padding: 0;
			}
			li.hidden {
				display: none;
			}
			.empty-message {
				margin: 0;
				padding: 3rem 0;
				text-align: center;
				color: rgb(var(--gray));
				font-size: 15px;
			}
			.empty-message.hidden {
				display: none;
			}
			.pagination {
				display: flex;
				align-items: center;
				justify-content: center;
				gap: 0.5rem;
				margin-top: 3rem;
			}
			.pagination a,
			.pagination span {
				display: inline-flex;
				align-items: center;
				justify-content: center;
				min-width: 2.25em;
				height: 2.25em;
				padding: 0 0.5em;
				border-radius: 8px;
				text-decoration: none;
				font-size: 15px;
				color: rgb(var(--gray-dark));
			}
			.pagination a:hover {
				background: rgb(var(--gray-light));
			}
			.pagination .current {
				background: var(--accent);
				color: white;
				font-weight: 600;
			}
			.pagination .disabled {
				color: rgb(var(--gray-light));
			}
			@media (max-width: 720px) {
				.banner {
					height: 160px;
				}
				main {
					padding-top: 1.5em;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<img class="banner" src="/banner.webp" alt="" />
		<main>
			<div class="tabs" id="category-tabs">
				<span class="tab-indicator" id="tab-indicator"></span>
				{categories.map((category, i) => (
					<button class="tab" class:list={[{ active: i === 0 }]} data-filter={category}>
						{category}
					</button>
				))}
			</div>
			<div class="list-wrapper" id="list-wrapper">
				<ul id="article-list">
					{page.data.map((post) => (
						<li data-category={post.data.category}>
							<ArticleListCard post={post} />
						</li>
					))}
				</ul>
				<p id="empty-message" class="empty-message hidden">이 카테고리에 글이 없습니다.</p>
			</div>
			{page.lastPage > 1 && (
				<nav class="pagination" aria-label="페이지 이동">
					{page.url.prev ? (
						<a href={page.url.prev}>이전</a>
					) : (
						<span class="disabled">이전</span>
					)}
					{pageNumbers.map((n) =>
						n === page.currentPage ? (
							<span class="current">{n}</span>
						) : (
							<a href={n === 1 ? '/' : `/${n}`}>{n}</a>
						),
					)}
					{page.url.next ? (
						<a href={page.url.next}>다음</a>
					) : (
						<span class="disabled">다음</span>
					)}
				</nav>
			)}
		</main>
		<Footer />
		<script>
			const tabs = document.querySelectorAll<HTMLButtonElement>('#category-tabs .tab');
			const items = document.querySelectorAll<HTMLLIElement>('#article-list > li');
			const indicator = document.getElementById('tab-indicator');
			const emptyMessage = document.getElementById('empty-message');

			const moveIndicator = (tab: HTMLButtonElement) => {
				if (!indicator) return;
				indicator.style.left = `${tab.offsetLeft}px`;
				indicator.style.width = `${tab.offsetWidth}px`;
			};

			const activeTab = document.querySelector<HTMLButtonElement>('#category-tabs .tab.active');
			if (activeTab) moveIndicator(activeTab);

			tabs.forEach((tab) => {
				tab.addEventListener('click', () => {
					tabs.forEach((t) => t.classList.remove('active'));
					tab.classList.add('active');
					moveIndicator(tab);

					const filter = tab.dataset.filter;
					let visibleCount = 0;
					items.forEach((item) => {
						const show = filter === 'All' || item.dataset.category === filter;
						item.classList.toggle('hidden', !show);
						if (show) visibleCount++;
					});

					emptyMessage?.classList.toggle('hidden', visibleCount > 0);
				});
			});
		</script>
	</body>
</html>
