---
import { Image } from 'astro:assets';
import Logo from '../assets/logo.png';
---

<header>
	<nav>
		<a class="brand" href="/">
			<Image src={Logo} alt="" width={28} height={28} />
			<h2>dozy tech</h2>
		</a>
		<a class="github-link" href="https://github.com/dozycoffee" target="_blank" rel="noopener">
			<svg viewBox="0 0 16 16" aria-hidden="true" width="20" height="20"
				><path
					fill="currentColor"
					d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"
				></path></svg
			>
			<span>GitHub</span>
		</a>
		<button class="search-button" type="button" aria-label="검색" aria-haspopup="dialog">
			<svg viewBox="0 0 24 24" aria-hidden="true" width="20" height="20" fill="none"
				stroke="currentColor" stroke-width="2" stroke-linecap="round"
				><circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.5-3.5"></path></svg
			>
		</button>
	</nav>
	<dialog class="search-dialog" aria-label="검색">
		<form class="search-form" method="dialog">
			<input
				class="search-input"
				type="search"
				placeholder="제목, 설명, 태그로 검색"
				autocomplete="off"
				aria-label="검색어"
			/>
			<button class="search-close" type="submit">닫기</button>
		</form>
		<ul class="search-results"></ul>
		<p class="search-empty" hidden>검색 결과가 없습니다.</p>
	</dialog>
</header>
<script>
	interface SearchItem {
		url: string;
		thumbnail: string;
		title: string;
		description: string;
		author: string;
		category: string;
		tags: string[];
	}

	const button = document.querySelector<HTMLButtonElement>('.search-button')!;
	const dialog = document.querySelector<HTMLDialogElement>('.search-dialog')!;
	const input = dialog.querySelector<HTMLInputElement>('.search-input')!;
	const results = dialog.querySelector<HTMLUListElement>('.search-results')!;
	const empty = dialog.querySelector<HTMLParagraphElement>('.search-empty')!;

	const RECENT_COUNT = 3;
	let index: SearchItem[] | null = null;

	async function loadIndex() {
		if (!index) {
			try {
				index = await (await fetch('/search.json')).json();
			} catch {
				index = [];
			}
		}
		return index!;
	}

	function render(items: SearchItem[], query: string) {
		results.replaceChildren(
			...items.map((item) => {
				const li = document.createElement('li');
				const a = document.createElement('a');
				a.href = item.url;
				const title = document.createElement('strong');
				title.textContent = item.title;
				const desc = document.createElement('span');
				desc.textContent = item.description;
				const text = document.createElement('div');
				text.append(title, desc);
				const thumb = document.createElement('img');
				thumb.src = item.thumbnail;
				thumb.alt = '';
				a.append(text, thumb);
				li.append(a);
				return li;
			}),
		);
		empty.hidden = items.length > 0 || query === '';
	}

	async function search() {
		const query = input.value.trim().toLowerCase();
		if (!query) return render((await loadIndex()).slice(0, RECENT_COUNT), '');
		const terms = query.split(/\s+/);
		const items = (await loadIndex()).filter((item) => {
			const haystack = [item.title, item.description, item.author, item.category, ...item.tags]
				.join(' ')
				.toLowerCase();
			return terms.every((term) => haystack.includes(term));
		});
		render(items, query);
	}

	button.addEventListener('click', () => {
		dialog.showModal();
		input.focus();
		search();
	});
	input.addEventListener('input', search);
	dialog.addEventListener('close', () => {
		input.value = '';
	});

	// Play the slide-up animation before actually closing.
	function closeDialog() {
		if (dialog.classList.contains('closing')) return;
		dialog.classList.add('closing');
		if (getComputedStyle(dialog).animationName === 'none') {
			dialog.dispatchEvent(new Event('animationend'));
		}
	}
	dialog.addEventListener('animationend', (e) => {
		if (e.target !== dialog || !dialog.classList.contains('closing')) return;
		dialog.classList.remove('closing');
		dialog.close();
	});
	// Esc: intercept the native close so the animation can run.
	dialog.addEventListener('cancel', (e) => {
		e.preventDefault();
		closeDialog();
	});
	dialog.querySelector('form')!.addEventListener('submit', (e) => {
		e.preventDefault();
		closeDialog();
	});
	dialog.addEventListener('click', (e) => {
		if (e.target === dialog) closeDialog();
	});
</script>
<style>
	header {
		position: sticky;
		top: 0;
		z-index: 20;
		margin: 0;
		/* Keep the header fixed while the page content cross-fades between pages. */
		view-transition-name: site-header;
		background: white;
		box-shadow: 0 2px 8px rgba(var(--black), 5%);
	}
	.brand {
		display: flex;
		align-items: center;
		gap: 0.5em;
		margin-right: auto;
		text-decoration: none;
	}
	.brand img {
		display: block;
		border-radius: 6px;
	}
	h2 {
		margin: 0;
		font-size: 1.25em;
	}
	h2,
	.brand {
		color: rgb(var(--black));
	}
	.github-link {
		display: flex;
		align-items: center;
		gap: 0.4em;
		padding: 0.5em 0.9em;
		border: 1px solid rgb(var(--gray-light));
		border-radius: 100px;
		color: rgb(var(--gray-dark));
		font-size: 14px;
		font-weight: 600;
		text-decoration: none;
		transition: 0.2s ease;
	}
	.github-link:hover {
		border-color: var(--accent);
		color: var(--accent);
	}
	.search-button {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 36px;
		height: 36px;
		margin-left: 0.5em;
		padding: 0;
		border: 1px solid rgb(var(--gray-light));
		border-radius: 100px;
		background: transparent;
		color: rgb(var(--gray-dark));
		cursor: pointer;
		transition: 0.2s ease;
	}
	.search-button:hover {
		border-color: var(--accent);
		color: var(--accent);
	}
	.search-dialog {
		width: 600px;
		max-width: calc(100% - 2em);
		margin: 10vh auto auto;
		padding: 0;
		border: none;
		border-radius: 16px;
		box-shadow: var(--box-shadow);
	}
	.search-dialog[open] {
		animation: search-slide-down 0.3s ease-out;
	}
	.search-dialog[open]::backdrop {
		animation: search-fade-in 0.3s ease-out;
	}
	.search-dialog::backdrop {
		background: rgba(var(--black), 40%);
	}
	.search-dialog.closing {
		animation: search-slide-up 0.25s ease-in forwards;
	}
	.search-dialog.closing::backdrop {
		animation: search-fade-out 0.25s ease-in forwards;
	}
	@keyframes search-slide-up {
		to {
			opacity: 0;
			transform: translateY(-32px);
		}
	}
	@keyframes search-fade-out {
		to {
			opacity: 0;
		}
	}
	@keyframes search-slide-down {
		from {
			opacity: 0;
			transform: translateY(-32px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}
	@keyframes search-fade-in {
		from {
			opacity: 0;
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.search-dialog[open],
		.search-dialog[open]::backdrop,
		.search-dialog.closing,
		.search-dialog.closing::backdrop {
			animation: none;
		}
	}
	.search-form {
		display: flex;
		align-items: center;
		gap: 0.5em;
		padding: 1em 1.25em;
		border-bottom: 1px solid rgb(var(--gray-light));
	}
	.search-input {
		flex: 1;
		min-width: 0;
		border: none;
		outline: none;
		background: transparent;
		color: rgb(var(--black));
		font: inherit;
		font-size: 18px;
	}
	.search-close {
		border: none;
		background: transparent;
		color: rgb(var(--gray));
		font: inherit;
		font-size: 14px;
		cursor: pointer;
	}
	.search-results {
		max-height: 50vh;
		margin: 0;
		padding: 0.5em;
		overflow-y: auto;
		list-style: none;
	}
	.search-results:empty {
		display: none;
	}
	.search-results :global(a) {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1em;
		padding: 0.75em 1em;
		border-radius: 12px;
		text-decoration: none;
	}
	.search-results :global(a:hover),
	.search-results :global(a:focus-visible) {
		background: rgb(var(--gray-light));
	}
	.search-results :global(div) {
		display: flex;
		flex: 1;
		flex-direction: column;
		min-width: 0;
	}
	.search-results :global(img) {
		flex: none;
		width: 120px;
		height: 68px;
		border-radius: 8px;
		object-fit: cover;
	}
	.search-results :global(strong) {
		color: rgb(var(--black));
		font-size: 16px;
	}
	.search-results :global(span) {
		overflow: hidden;
		color: rgb(var(--gray));
		font-size: 14px;
		white-space: nowrap;
		text-overflow: ellipsis;
	}
	.search-empty {
		margin: 0;
		padding: 2em;
		color: rgb(var(--gray));
		text-align: center;
	}
	nav {
		display: flex;
		align-items: center;
		width: 960px;
		max-width: calc(100% - 2em);
		margin: 0 auto;
		padding: 1em 0;
	}
</style>
