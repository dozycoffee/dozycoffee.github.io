---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import DefaultThumbnail from '../assets/default-thumbnail.webp';
import FormattedDate from './FormattedDate.astro';

interface Props {
	post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { title, description, author, category, tags, pubDate, heroImage } = post.data;
const visibleTags = tags.slice(0, 3);
---

<a class="card" href={`/blog/${post.id}/`} data-category={category}>
	<div class="thumbnail">
		<Image width={480} height={340} src={heroImage ?? DefaultThumbnail} alt="" />
	</div>
	<div class="content">
		<div class="meta">
			<span class="meta-left">
				<span class="category">{category}</span>
				<span class="author">{author}</span>
			</span>
			<FormattedDate date={pubDate} />
		</div>
		<h3 class="title">{title}</h3>
		<p class="description">{description}</p>
		{visibleTags.length > 0 && (
			<div class="tags">
				{visibleTags.map((tag) => <span class="tag">#{tag}</span>)}
			</div>
		)}
	</div>
</a>

<style>
	.card {
		display: flex;
		border: 1px solid rgb(var(--gray-light));
		border-radius: 16px;
		overflow: hidden;
		text-decoration: none;
		transition: 0.2s ease;
	}
	.thumbnail {
		flex: 0 0 42%;
	}
	.thumbnail img {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}
	.content {
		flex: 1;
		min-width: 0;
		display: flex;
		flex-direction: column;
		justify-content: center;
		gap: 0.75rem;
		padding: 2rem;
	}
	.meta {
		display: flex;
		align-items: center;
		justify-content: space-between;
		font-size: 14px;
		color: rgb(var(--gray));
	}
	.meta-left {
		display: inline-flex;
		align-items: center;
	}
	.category {
		font-weight: 600;
		color: var(--accent-dark);
	}
	.author::before {
		content: '·';
		margin: 0 0.5rem;
	}
	.title {
		margin: 0;
		color: rgb(var(--black));
		font-size: 22px;
		line-height: 1.4;
		overflow: hidden;
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
	}
	.description {
		margin: 0;
		color: rgb(var(--gray));
		font-size: 15px;
		overflow: hidden;
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
	}
	.tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		margin-top: 0.5rem;
	}
	.tag {
		padding: 0.25em 0.75em;
		border-radius: 100px;
		background-color: rgb(var(--gray-light));
		color: rgb(var(--gray-dark));
		font-size: 13px;
	}
	.card:hover .title {
		color: var(--accent);
	}
	@media (max-width: 640px) {
		.card {
			flex-direction: column;
		}
		.thumbnail {
			flex: none;
		}
		.thumbnail img {
			height: 200px;
		}
		.content {
			padding: 1.25rem;
		}
	}
</style>
