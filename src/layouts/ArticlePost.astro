---
import 'katex/dist/katex.min.css';
import { Image } from 'astro:assets';
import type { MarkdownHeading } from 'astro';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import DefaultThumbnail from '../assets/default-thumbnail.webp';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { SITE_TITLE } from '../consts';

type Props = CollectionEntry<'article'>['data'] & {
	/** Headings of the article body, as returned by `render()`. */
	headings?: MarkdownHeading[];
};

const { title, description, author, category, pubDate, updatedDate, heroImage, headings = [] } =
	Astro.props;

// The table of contents lists h1-h3 of the body only.
const tocHeadings = headings.filter((heading) => heading.depth <= 3);
const tocBaseDepth = Math.min(...tocHeadings.map((heading) => heading.depth));
---

<html lang="ko">
	<head>
		<BaseHead
			title={`${title} | ${SITE_TITLE}`}
			description={description}
			image={heroImage}
			type="article"
			publishedTime={pubDate}
			modifiedTime={updatedDate}
			author={author}
		/>
		<style>
			main {
				width: calc(100% - 2em);
				max-width: 100%;
				margin: 0;
			}
			.hero-image {
				width: 720px;
				max-width: calc(100% - 2em);
				margin: 0 auto;
				padding: 1em 1em 0;
			}
			.hero-image img {
				display: block;
				width: 100%;
				height: auto;
				border-radius: 12px;
				box-shadow: var(--box-shadow);
			}
			.prose {
				position: relative;
				width: 720px;
				max-width: calc(100% - 2em);
				margin: auto;
				padding: 1em;
				color: rgb(var(--gray-dark));
			}
			.title {
				margin-bottom: 2em;
				padding: 1.5em 0 2em;
				border-bottom: 1px solid rgb(var(--gray-light));
			}
			.category {
				margin: 0 0 0.75rem;
				color: var(--accent-dark);
				font-size: 15px;
				font-weight: 600;
			}
			.title h1 {
				margin: 0 0 1rem;
				font-size: 32px;
				line-height: 1.35;
			}
			.subtitle {
				margin: 0 0 1.5rem;
				color: rgb(var(--gray-dark));
				font-size: 17px;
				line-height: 1.5;
			}
			.meta {
				display: flex;
				flex-wrap: wrap;
				align-items: center;
				color: rgb(var(--gray));
				font-size: 14px;
			}
			.meta > * + *::before {
				content: '·';
				margin: 0 0.5rem;
			}
			/* Table of contents: floats in the empty space to the right of the article */
			.toc-rail {
				display: none;
			}
			.prose > :global(h1),
			.prose > :global(h2),
			.prose > :global(h3) {
				scroll-margin-top: 6rem;
			}
			@media (min-width: 1280px) {
				.toc-rail {
					position: absolute;
					top: 0;
					bottom: 0;
					left: calc(100% + 1.5rem);
					display: block;
					width: 220px;
					padding-top: 4rem;
				}
				.toc {
					position: sticky;
					top: 8rem;
					max-height: calc(100vh - 10rem);
					overflow-y: auto;
					font-size: 14px;
					line-height: 1.5;
				}
				.toc-title {
					margin: 0 0 0.75rem;
					color: rgb(var(--black));
					font-weight: 600;
				}
				.toc ul {
					margin: 0;
					padding: 0;
					border-left: 2px solid rgb(var(--gray-light));
					list-style: none;
				}
				.toc a {
					display: block;
					margin-left: -2px;
					padding: 0.3em 0.5em 0.3em calc(0.9em + var(--depth) * 0.9em);
					border-left: 2px solid transparent;
					color: rgb(var(--gray));
					text-decoration: none;
					transition: 0.2s ease;
				}
				.toc a:hover {
					color: rgb(var(--gray-dark));
				}
				.toc a.active {
					border-left-color: var(--accent);
					color: var(--accent);
					font-weight: 600;
				}
			}
			/* Headings inside the article body (the page title above is a separate h1). */
			.prose > :global(h1),
			.prose > :global(h2),
			.prose > :global(h3),
			.prose > :global(h4),
			.prose > :global(h5),
			.prose > :global(h6) {
				margin: 3.5rem 0 0.75rem;
				font-weight: 600;
			}
			.prose > :global(h1) {
				margin-top: 5rem;
				font-size: 26px;
				font-weight: 700;
				line-height: 1.4;
			}
			.prose > :global(h2) {
				margin-top: 4.5rem;
				font-size: 22px;
				line-height: 1.4;
			}
			.prose > :global(h3) {
				margin-top: 4rem;
				font-size: 19px;
				line-height: 1.45;
			}
			.prose > :global(h4),
			.prose > :global(h5),
			.prose > :global(h6) {
				font-size: 17px;
				line-height: 1.5;
			}
			/* Lists */
			.prose :global(ul),
			.prose :global(ol) {
				margin: 0 0 2em;
				padding-left: 1.4em;
				line-height: 1.65;
			}
			.prose :global(ul) {
				list-style: disc;
			}
			.prose :global(ul ul) {
				list-style: circle;
			}
			.prose :global(ul ul ul) {
				list-style: square;
			}
			.prose :global(li) {
				margin-bottom: 0.45em;
			}
			.prose :global(li:last-child) {
				margin-bottom: 0;
			}
			.prose :global(li::marker) {
				color: var(--accent);
			}
			.prose :global(ol > li::marker) {
				font-weight: 600;
			}
			.prose :global(li > ul),
			.prose :global(li > ol) {
				margin: 0.4em 0 0;
			}
			/* Task lists (GFM checkboxes): no bullet marker */
			.prose :global(ul.contains-task-list) {
				padding-left: 0;
				list-style: none;
			}
			.prose :global(li.task-list-item) {
				list-style: none;
			}
			.prose :global(li.task-list-item > input) {
				margin: 0 0.5em 0 0;
				accent-color: var(--accent);
				vertical-align: middle;
			}
			.prose :global(li > p) {
				margin-bottom: 0.45em;
			}
			.prose :global(li > p:last-child) {
				margin-bottom: 0;
			}
			/* Blockquote */
			.prose :global(blockquote) {
				margin: 0 0 2em;
				padding: 0.25em 0 0.25em 1.25em;
				border-left: 4px solid var(--accent);
				color: rgb(var(--gray));
				font-size: 1em;
				line-height: 1.7;
			}
			.prose :global(blockquote > p) {
				margin-top: 0;
				margin-bottom: 0.75em;
			}
			.prose :global(blockquote > :last-child) {
				margin-bottom: 0;
			}
			/* Math (KaTeX) */
			.prose :global(.katex-display) {
				margin: 0 0 2em;
				overflow: auto hidden;
			}
			/* Horizontal rule */
			.prose > :global(hr) {
				margin: 3.5em 0;
				border: none;
				border-top: 1px solid #d1d6db;
			}
			/* Footnotes: "1)" style references and a divider-separated list at the end */
			.prose :global(a[data-footnote-ref]) {
				margin-left: 0.1em;
				font-size: 0.8em;
				font-weight: 600;
				text-decoration: none;
			}
			.prose :global(a[data-footnote-ref]::after) {
				content: ')';
			}
			.prose :global([id^='user-content-fn']) {
				scroll-margin-top: 6rem;
			}
			.prose :global(section.footnotes) {
				margin-top: 4em;
				padding-top: 1.5em;
				border-top: 1px solid #d1d6db;
				color: rgb(var(--gray));
				font-size: 14px;
			}
			.prose :global(section.footnotes ol) {
				margin: 0;
				padding-left: 1.8em;
			}
			.prose :global(section.footnotes li::marker) {
				content: counter(list-item) ')  ';
				font-weight: 600;
			}
			.prose :global(section.footnotes li > p) {
				margin: 0;
			}
			.prose :global(a[data-footnote-backref]) {
				margin-left: 0.25em;
				text-decoration: none;
			}
			/* Collapsible sections (details/summary) */
			.prose :global(details) {
				margin: 0 0 2em;
			}
			.prose :global(details > summary) {
				display: flex;
				align-items: center;
				gap: 0.75em;
				padding: 0.4em 0;
				color: rgb(var(--gray-dark));
				font-weight: 600;
				list-style: none;
				cursor: pointer;
				user-select: none;
				transition: color 0.25s ease;
			}
			.prose :global(details > summary::-webkit-details-marker) {
				display: none;
			}
			.prose :global(details > summary::before) {
				content: '';
				flex: none;
				width: 0;
				height: 0;
				border-top: 5px solid transparent;
				border-bottom: 5px solid transparent;
				border-left: 8px solid currentColor;
				transition: transform 0.35s cubic-bezier(0.34, 1.56, 0.64, 1);
			}
			.prose :global(details > summary:hover) {
				color: var(--accent);
			}
			.prose :global(details[open] > summary) {
				color: var(--accent);
			}
			.prose :global(details[open] > summary::before) {
				transform: rotate(90deg);
			}
			/* Indent the hidden content to line up with the summary text (arrow 8px + gap 0.75em) */
			.prose :global(details > :not(summary)) {
				margin-left: calc(8px + 0.75em);
			}
			.prose :global(details > summary + *) {
				margin-top: 0.75em;
			}
			.prose :global(details > :last-child) {
				margin-bottom: 0;
			}
			.prose :global(details[open] > :not(summary)) {
				animation: details-reveal 0.3s ease-out;
			}
			@keyframes details-reveal {
				from {
					opacity: 0;
					transform: translateY(-6px);
				}
			}
			@media (prefers-reduced-motion: reduce) {
				.prose :global(details > summary::before),
				.prose :global(details[open] > :not(summary)) {
					transition: none;
					animation: none;
				}
			}
			@media (max-width: 720px) {
				.title h1 {
					font-size: 25px;
				}
				.subtitle {
					font-size: 15px;
				}
				.prose > :global(h1) {
					font-size: 23px;
				}
				.prose > :global(h2) {
					font-size: 20px;
				}
				.prose > :global(h3) {
					font-size: 18px;
				}
			}
		</style>
	</head>

	<body>
		<Header />
		<main>
			<article>
				<div class="hero-image">
					<Image width={1020} height={510} src={heroImage ?? DefaultThumbnail} alt="" />
				</div>
				<div class="prose">
					{tocHeadings.length > 0 && (
						<aside class="toc-rail">
							<nav class="toc" aria-label="목차">
								<p class="toc-title">목차</p>
								<ul>
									{tocHeadings.map((heading) => (
										<li style={`--depth: ${heading.depth - tocBaseDepth}`}>
											<a href={`#${heading.slug}`} data-id={heading.slug}>
												{heading.text}
											</a>
										</li>
									))}
								</ul>
							</nav>
						</aside>
					)}
					<div class="title">
						<p class="category">{category}</p>
						<h1>{title}</h1>
						<p class="subtitle">{description}</p>
						<div class="meta">
							<span><FormattedDate date={pubDate} /></span>
							{updatedDate && <span>수정 <FormattedDate date={updatedDate} /></span>}
							<span>{author}</span>
						</div>
					</div>
					<slot />
				</div>
			</article>
		</main>
		<Footer />
		<script>
			const COPY_ICON =
				'<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="12" height="12" rx="2"></rect><path d="M5 15V5a2 2 0 0 1 2-2h10"></path></svg>';
			const CHECK_ICON =
				'<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m5 12 5 5L20 7"></path></svg>';

			// Highlight the table-of-contents entry of the section being read.
			const tocLinks = [...document.querySelectorAll<HTMLAnchorElement>('.toc a')];
			if (tocLinks.length > 0) {
				const sections = tocLinks.map((link) => document.getElementById(link.dataset.id ?? ''));
				let ticking = false;
				// Set when an entry is clicked: the page may be unable to scroll far enough to
				// bring a short section to the threshold, so keep the clicked entry highlighted
				// until the reader scrolls by themselves.
				let lockedIndex = -1;

				const highlight = (index: number) =>
					tocLinks.forEach((link, i) => link.classList.toggle('active', i === index));

				const update = () => {
					ticking = false;
					if (lockedIndex >= 0) return highlight(lockedIndex);
					let current = -1;
					sections.forEach((section, i) => {
						if (section && section.getBoundingClientRect().top <= 120) current = i;
					});
					// At the very bottom the last section can't scroll up to the threshold.
					const atBottom = window.innerHeight + window.scrollY >= document.body.scrollHeight - 2;
					if (atBottom) current = sections.length - 1;
					highlight(current);
				};

				const schedule = () => {
					if (!ticking) {
						ticking = true;
						requestAnimationFrame(update);
					}
				};
				const unlock = () => {
					if (lockedIndex < 0) return;
					lockedIndex = -1;
					schedule();
				};

				// Eased scrolling: the browser's built-in smooth scroll has a fixed, abrupt curve.
				const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
				const easeInOutCubic = (t: number) =>
					t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2;
				let frame = 0;
				const stopScrolling = () => cancelAnimationFrame(frame);
				const scrollToSection = (section: HTMLElement) => {
					stopScrolling();
					const offset = parseFloat(getComputedStyle(section).scrollMarginTop) || 0;
					const maxTop = document.documentElement.scrollHeight - window.innerHeight;
					const from = window.scrollY;
					const to = Math.min(Math.max(section.getBoundingClientRect().top + from - offset, 0), maxTop);
					if (reducedMotion.matches || from === to) {
						window.scrollTo({ top: to, behavior: 'instant' });
						return;
					}
					const duration = Math.min(Math.max(Math.abs(to - from) * 0.8, 500), 1000);
					const start = performance.now();
					const step = (now: number) => {
						const progress = Math.min((now - start) / duration, 1);
						window.scrollTo({ top: from + (to - from) * easeInOutCubic(progress), behavior: 'instant' });
						if (progress < 1) frame = requestAnimationFrame(step);
					};
					frame = requestAnimationFrame(step);
				};

				tocLinks.forEach((link, i) =>
					link.addEventListener('click', (e) => {
						const section = sections[i];
						if (!section) return;
						e.preventDefault();
						history.replaceState(null, '', link.hash);
						lockedIndex = i;
						highlight(i);
						scrollToSection(section);
					}),
				);
				// Scrolling by hand stops the animation and hands control back to the scroll position.
				// (Programmatic scrolling doesn't fire these events.)
				const takeOver = () => {
					stopScrolling();
					unlock();
				};
				window.addEventListener('wheel', takeOver, { passive: true });
				window.addEventListener('touchmove', takeOver, { passive: true });
				window.addEventListener('keydown', (e) => {
					if (['ArrowUp', 'ArrowDown', 'PageUp', 'PageDown', 'Home', 'End', ' '].includes(e.key)) {
						takeOver();
					}
				});
				window.addEventListener('scroll', schedule, { passive: true });
				update();
			}

			// Click-to-zoom viewer for images in the article body.
			const viewer = document.createElement('dialog');
			viewer.className = 'image-viewer';
			viewer.setAttribute('aria-label', '이미지 크게 보기');
			const viewerImage = document.createElement('img');
			viewer.append(viewerImage);
			document.body.append(viewer);

			function closeViewer() {
				if (viewer.classList.contains('closing')) return;
				viewer.classList.add('closing');
				if (getComputedStyle(viewer).animationName === 'none') {
					viewer.dispatchEvent(new Event('animationend'));
				}
			}
			viewer.addEventListener('animationend', (e) => {
				if (e.target !== viewer || !viewer.classList.contains('closing')) return;
				viewer.classList.remove('closing');
				viewer.close();
			});
			viewer.addEventListener('cancel', (e) => {
				e.preventDefault();
				closeViewer();
			});
			viewer.addEventListener('click', closeViewer);

			document.querySelectorAll<HTMLImageElement>('.prose img').forEach((img) => {
				if (img.closest('a')) return;
				img.addEventListener('click', () => {
					viewerImage.src = img.currentSrc || img.src;
					viewerImage.alt = img.alt;
					viewer.showModal();
				});
			});

			document.querySelectorAll<HTMLTableElement>('.prose table').forEach((table) => {
				const wrapper = document.createElement('div');
				wrapper.className = 'table-wrapper';
				table.replaceWith(wrapper);
				wrapper.append(table);
			});

			document.querySelectorAll<HTMLPreElement>('.prose pre[data-language]').forEach((pre) => {
				const language = pre.dataset.language;
				const wrapper = document.createElement('div');
				wrapper.className = 'code-block';

				const header = document.createElement('div');
				header.className = 'code-header';
				const label = document.createElement('span');
				label.textContent = !language || language === 'plaintext' ? 'text' : language;
				const button = document.createElement('button');
				button.type = 'button';
				button.className = 'code-copy';
				button.setAttribute('aria-label', '코드 복사');
				button.innerHTML = COPY_ICON;
				header.append(label, button);

				pre.replaceWith(wrapper);
				wrapper.append(header, pre);

				let timer: number | undefined;
				button.addEventListener('click', async () => {
					try {
						await navigator.clipboard.writeText((pre.textContent ?? '').replace(/\n$/, ''));
						button.innerHTML = CHECK_ICON;
						button.setAttribute('aria-label', '복사됨');
						button.classList.add('copied');
					} catch {
						button.setAttribute('aria-label', '복사 실패');
					}
					clearTimeout(timer);
					timer = window.setTimeout(() => {
						button.innerHTML = COPY_ICON;
						button.setAttribute('aria-label', '코드 복사');
						button.classList.remove('copied');
					}, 1500);
				});
			});
		</script>
	</body>
</html>
